{
  "expo": {
    "name": "Cryptolyzer.AI",
    "slug": "cryptolyzer",
    "version": "1.0.0",
    "scheme": "cryptolyzer",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.cryptolyzer.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.cryptolyzer.app",
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5",
        "foregroundImage": "./assets/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4f46e5"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#4f46e5"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cryptolyzer necesita acceso a tus fotos para subir la captura de un gráfico.",
          "cameraPermission": "Cryptolyzer necesita la cámara para fotografiar un gráfico y analizarlo."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon-foreground.png",
          "color": "#4f46e5"
        }
      ]
    ]
  }
}
