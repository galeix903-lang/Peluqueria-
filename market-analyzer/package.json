{
  "name": "market-analyzer",
  "version": "1.0.0",
  "description": "Dashboard de análisis de mercado con IA: sube una captura de un gráfico y recibe un análisis, más paper trading y picks diarios.",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate:json": "node server/scripts/migrate-json-to-pg.js",
    "test": "node --test server/test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.0",
    "node-cron": "^4.0.0",
    "pg": "^8.23.0",
    "session-file-store": "^1.5.0",
    "stripe": "^17.4.0"
  }
}
