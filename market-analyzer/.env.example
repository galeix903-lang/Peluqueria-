# Puerto del servidor
PORT=3100

# Cadena de conexión a Postgres. En local, la de tu Postgres de
# desarrollo (ver README, sección "Base de datos"); en Render, la que da
# automáticamente la base de datos gestionada que crea render.yaml.
DATABASE_URL=postgres://vantex:vantex_dev_local@localhost:5432/vantex

# Clave para firmar la cookie de sesión (pon cualquier cadena larga y aleatoria)
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Firma el access token (JWT de corta duración) de la app móvil. El
# refresh token es opaco y se guarda hasheado en la base de datos, no
# necesita clave propia.
JWT_ACCESS_SECRET=cambia-esto-por-otra-cadena-larga-y-aleatoria

# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys).
# Sin esto, el analizador funciona igual pero en modo de ejemplo (ANALYZER_MODE
# se fuerza a "mock" automáticamente).
ANTHROPIC_API_KEY=

# "auto" (usa Claude si hay API key, si no cae a modo mock), "mock" (forzar
# siempre ejemplos, útil para desarrollar sin gastar créditos) o "live"
# (forzar Claude real; falla si no hay API key).
ANALYZER_MODE=auto

# Suscripción de pago "Vantex Pro" (ver README, sección "Cobrar con Stripe").
# Sin STRIPE_SECRET_KEY/STRIPE_PRICE_ID, el botón "Hazte Pro" funciona en
# modo de ejemplo: marca al usuario como Pro al instante, sin Stripe real.
BILLING_MODE=auto
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
